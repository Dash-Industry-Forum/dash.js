{
  "headless": true,
  "browsers": [
    {
      "name": "Chrome",
      "capabilities": {
        "browserName": "chrome",
        "goog:chromeOptions": {
          "channel": "chrome",
          "args": [
            "--disable-web-security",
            "--autoplay-policy=no-user-gesture-required",
            "--disable-popup-blocking",
            "--disable-search-engine-choice-screen"
          ]
        }
      }
    },
    {
      "name": "Firefox",
      "capabilities": {
        "browserName": "firefox",
        "moz:firefoxOptions": {
          "prefs": {
            "media.eme.enabled": true
          }
        }
      }
    }
  ],
  "parallelTestFiles": 3,
  "parallelBrowsers": 2
}
