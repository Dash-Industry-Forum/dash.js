root = true

[*]
end_of_line = lf
charset = utf-8
indent_style = space
indent_size = 4
trim_trailing_whitespace = false
insert_final_newline = false

[*.js]
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = 120
ij_visual_guides = 120
ij_wrap_on_typing = false
# WebStorm reformat (Ctrl+Alt+L): wrap only constructs that exceed max_line_length
ij_javascript_call_parameters_wrap = on_every_item
ij_javascript_method_parameters_wrap = on_every_item
ij_javascript_method_call_chain_wrap = on_every_item
ij_javascript_binary_operation_wrap = normal
ij_javascript_ternary_operation_wrap = on_every_item
ij_javascript_array_initializer_wrap = normal
ij_javascript_object_literal_wrap = on_every_item
ij_javascript_wrap_comments = true

[*.md]
insert_final_newline = true
